<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F7FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- Foto Produk -->
        <ImageView
            android:id="@+id/imageDetail"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:background="#FFFFFF"
            android:contentDescription="Gambar produk"
            android:scaleType="centerCrop" />

        <!-- Informasi Produk -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Nama -->
            <TextView
                android:id="@+id/textDetailName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nama Produk"
                android:textColor="#17171A"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Harga -->
            <TextView
                android:id="@+id/textDetailPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Rp299.000"
                android:textColor="#5B4BFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Rating -->
            <TextView
                android:id="@+id/textDetailRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="★ 4.8"
                android:textColor="#F4A623"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Kategori -->
            <TextView
                android:id="@+id/textDetailCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Kategori: Elektronik"
                android:textColor="#777A85"
                android:textSize="14sp" />

            <!-- Garis pemisah -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:background="#EEEEF2" />

            <!-- Deskripsi -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Deskripsi Produk"
                android:textColor="#17171A"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textDetailDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Deskripsi produk"
                android:textColor="#555861"
                android:textSize="15sp"
                android:lineSpacingExtra="5dp" />

            <!-- Stok -->
            <TextView
                android:id="@+id/textDetailStock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Stok tersedia: 10"
                android:textColor="#2E7D32"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Tombol -->
            <Button
                android:id="@+id/buttonAddToCart"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="22dp"
                android:backgroundTint="#5B4BFF"
                android:text="🛒  Tambah ke Keranjang"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>