<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F7FB"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Success Icon -->
    <TextView
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:background="#E8F5E9"
        android:gravity="center"
        android:text="✓"
        android:textColor="#2E7D32"
        android:textSize="52sp"
        android:textStyle="bold" />

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:gravity="center"
        android:text="Pembayaran Berhasil!"
        android:textColor="#17171A"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="Terima kasih, pesanan kamu berhasil dibuat."
        android:textColor="#777A85"
        android:textSize="14sp" />

    <!-- Payment Summary -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="#FFFFFF"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Total Pembayaran"
            android:textColor="#777A85"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/textSuccessTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Total Pembayaran: Rp0"
            android:textColor="#5B4BFF"
            android:textSize="22sp"
            android:textStyle="bold" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:text="Pesanan kamu sedang diproses."
        android:textColor="#777A85"
        android:textSize="14sp" />

    <!-- Back Home -->
    <Button
        android:id="@+id/buttonBackHome"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="#5B4BFF"
        android:text="Kembali ke Beranda  →"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>