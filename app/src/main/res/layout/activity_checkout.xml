<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F7FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Checkout"
            android:textColor="#17171A"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Lengkapi informasi pengiriman pesanan"
            android:textColor="#777A85"
            android:textSize="14sp" />

        <!-- Alamat -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📍  Alamat Pengiriman"
                android:textColor="#17171A"
                android:textSize="17sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editAddress"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="12dp"
                android:background="#F6F7FB"
                android:gravity="top"
                android:hint="Masukkan alamat lengkap di Cirebon"
                android:inputType="textMultiLine"
                android:padding="14dp"
                android:textColor="#17171A"
                android:textColorHint="#999999"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Pengiriman -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🚚  Metode Pengiriman"
                android:textColor="#17171A"
                android:textSize="17sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/shippingGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <RadioButton
                    android:id="@+id/radioRegular"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:buttonTint="#5B4BFF"
                    android:text="Regular   —   Rp10.000"
                    android:textColor="#33343A"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/radioExpress"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:buttonTint="#5B4BFF"
                    android:text="Express   —   Rp20.000"
                    android:textColor="#33343A"
                    android:textSize="15sp" />

            </RadioGroup>

        </LinearLayout>

        <!-- Total -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Total Pembayaran"
                android:textColor="#777A85"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textCheckoutTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Total: Rp0"
                android:textColor="#5B4BFF"
                android:textSize="22sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Tombol -->
        <Button
            android:id="@+id/buttonContinueCheckout"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="18dp"
            android:backgroundTint="#5B4BFF"
            android:text="Lanjut ke Pembayaran  →"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>